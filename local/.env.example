# Optional overrides for local/compose.yaml (LOCAL DEVELOPMENT ONLY).
# Copy to local/.env (git-ignored) and adjust. Docker Compose reads .env from the compose file's directory.
# Never put real credentials here; the stack only uses throwaway local values.

# Host port of the edge proxy (http://127.0.0.1:${ATLAS_EDGE_PORT}).
ATLAS_EDGE_PORT=8000

# Host port of PostgreSQL. Change (e.g. 5433) if atlas-microservices/compose.yaml or another PostgreSQL
# already listens on 5432.
ATLAS_DB_PORT=5432

# Spring profile used by the backend container (`dev` by default; never `local` - see local/README.md).
ATLAS_BACKEND_PROFILE=dev

# Paths to the sibling repositories, relative to the local/ directory (or absolute).
ATLAS_BACKEND_DIR=../../atlas-microservices
ATLAS_FRONTEND_DIR=../../atlas
